{
  "name": "cc-creative-mobile",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:package": "powershell -ExecutionPolicy Bypass -File tools/build-android-debug.ps1"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/preferences": "8.0.1",
    "lucide": "1.28.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "vite": "7.1.7"
  }
}
